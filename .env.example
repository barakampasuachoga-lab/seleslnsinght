# SalesInsight Environment Configuration Template
# Copy this file to .env and configure for local deployment

# Database Configuration (PostgreSQL)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="salesinsight_db"
DB_USER="postgres"
DB_PASSWORD="your_secure_password_here"

# Database Connection URL (Optional override, e.g., postgresql://user:password@localhost:5432/salesinsight_db)
# For local SQLite fallback in testing: sqlite:///salesinsight.db
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/salesinsight_db"

# Data Pipeline Settings
RAW_DATA_PATH="data/raw/superstore.csv"
PROCESSED_DATA_PATH="data/processed/sales_cleaned.csv"

# Runtime Environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
